# ──────────────────────────────────────────────────────────────────
# Intelligent Feedback Engine — Environment Variables
# ──────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
#
#   cp .env.example .env
#
# ──────────────────────────────────────────────────────────────────

# Groq API Key — obtain from https://console.groq.com/
# If omitted, the engine will use rule-based fallback explanations.
GROQ_API_KEY=your_groq_api_key_here

# Port the feedback engine listens on (default: 3001)
# Note: Sentinel's Member 2 backend uses port 3000 — do not conflict.
PORT=3001

# Log level: debug | info | warn | error
LOG_LEVEL=info
